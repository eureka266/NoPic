{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional motion configuration for a shared cover project",
  "type": "object",
  "required": ["schema_version", "engine", "type", "source_size"],
  "properties": {
    "schema_version": {"const": 1},
    "engine": {"enum": ["layer-loop", "background-frames"]},
    "type": {"const": "partnership-grid-flow"},
    "source_size": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 10000}, "minItems": 2, "maxItems": 2},
    "base": {"type": "string", "minLength": 1},
    "frames": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60, "default": 5},
    "fps": {"type": "integer", "minimum": 1, "maximum": 60, "default": 30},
    "formats": {"type": "array", "items": {"enum": ["mp4", "gif"]}, "minItems": 1, "uniqueItems": true},
    "style": {"enum": ["preserve", "blocksec-black", "blocksec-blue", "blocksec-orange", "blocksec-blue-orange"]},
    "layers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "file", "offset"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "file": {"type": "string", "minLength": 1},
          "mask": {"type": ["string", "null"]},
          "offset": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2}
        }
      }
    }
  },
  "allOf": [{"if": {"properties": {"engine": {"const": "layer-loop"}}}, "then": {"required": ["base", "layers"]}, "else": {"required": ["frames"]}}]
}
