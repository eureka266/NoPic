{
  "schema_version": 1,
  "id": "seminar-summary-portrait",
  "display_name": "活动概要｜竖版",
  "version": 1,
  "legacy_layout": "seminar-summary",
  "canvas": {
    "width": 1200,
    "height": 1600,
    "unit": "px"
  },
  "layers": {
    "blocksec-logo": {
      "type": "image",
      "display_name": "BlockSec Logo",
      "asset_field": "logo",
      "x": 848,
      "y": 64,
      "width": 268,
      "height": 92,
      "horizontal_align": "center",
      "vertical_align": "center",
      "lock_aspect_ratio": true,
      "trim_transparent": true
    },
    "event-details": {
      "type": "text",
      "display_name": "活动名称与日期",
      "content_field": [
        "event",
        "event_date"
      ],
      "x": 84,
      "y": 70,
      "width": 640,
      "height": 110,
      "font_size_max": 25,
      "font_size_min": 20,
      "align": "left",
      "color_role": "muted",
      "font_role": "font"
    },
    "main-title": {
      "type": "text",
      "display_name": "概要标题",
      "content_field": "title",
      "x": 84,
      "y": 266,
      "width": 1032,
      "height": 300,
      "font_size_max": 64,
      "font_size_min": 42,
      "align": "left",
      "color_role": "text",
      "font_role": "font_bold"
    },
    "footer-note": {
      "type": "text",
      "display_name": "页脚说明",
      "content_field": "footer",
      "x": 84,
      "y": 1524,
      "width": 1032,
      "height": 44,
      "font_size_max": 23,
      "font_size_min": 18,
      "align": "left",
      "color_role": "muted",
      "font_role": "font"
    }
  },
  "section_pattern": {
    "top": 630,
    "total_height": 850,
    "min_count": 1,
    "max_count": 4,
    "layers": {
      "accent": {
        "type": "line",
        "display_name": "要点 {number} 强调线",
        "x": 84,
        "y_offset": 0,
        "width": 62,
        "line_width": 4,
        "color_role": "orange"
      },
      "heading": {
        "type": "text",
        "display_name": "要点 {number} 标题",
        "content_field": "heading",
        "x": 84,
        "y_offset": 20,
        "width": 820,
        "height": 58,
        "font_size_max": 28,
        "font_size_min": 22,
        "align": "left",
        "color_role": "orange",
        "font_role": "font_bold"
      },
      "body": {
        "type": "text",
        "display_name": "要点 {number} 正文",
        "content_field": "body",
        "x": 84,
        "y_offset": 90,
        "width": 820,
        "height_inset": 120,
        "font_size_max": 36,
        "font_size_min": 26,
        "align": "left",
        "color_role": "text",
        "font_role": "font"
      }
    }
  }
}
